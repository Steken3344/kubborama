+    const charset = ' \tABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!?.,;:\'"()-[]{}@#$%&*+=/\\<>åäöÅÄÖ';
+    const loaded = new TTFLoader().loadAsync({ url: src, charset });
     ttfLoads.set(src, loaded);
     return loaded;
 }
