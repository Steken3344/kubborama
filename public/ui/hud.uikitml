<!--
  Always-visible scoreboard on a fixed 220 × 160 board (5 rows of ~25
  plus a little slack — no row value may wrap: keep values short; the
  wooden frame in src/scene-assets/hud-frame.scene-asset.ts is cut to
  the same size — the panel must never grow past it). Practice shows
  round, felled, record and style; a match swaps the last three for
  "Du är", the score and the turn, plus ONE message row at a time
  (inkast left / how it ended / a foot fault) — see src/systems/hud.ts.

  Originally: current round number, last round's
  result, the personal-best "most felled in one round", and the most
  recent throw's classified style (underhand/overhand/helicopter,
  informational only per docs/PLAN.md). Driven by src/systems/hud.ts,
  which listens for RoundEnded and Thrown — no per-frame polling
  needed, only updates when something actually happens.

  å/ä/ö and ✓ now render correctly (gh#5, see public/ui/reset-menu
  .uikitml and docs/DECISIONS.md for the fix). Labels driven by
  src/i18nState.ts, refreshed by HudSystem on language change.

  NOTE: no CSS comments inside <style> — the UIKitML stylesheet parser
  rejects them (build error "Unsupported stylesheet selector"). The
  .score rule (MP3b) lays the two score numbers out as separate spans
  so each can carry its player's avatar color.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    justify-content: center;
    font-family: "DM Sans";
    width: 220px;
    height: 160px;
    background-color: rgba(20, 20, 20, 0.55);
    border-radius: 12px;
    padding: 14px;
  }

  .row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 4px;
    padding-bottom: 4px;
  }

  .score {
    flex-direction: row;
    gap: 4px;
  }

  .label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
  }

  .value {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
  }
</style>
<Panel class="panel-root">
  <div class="row">
    <span id="round-label" class="label">Runda</span>
    <span id="round-number" class="value">1</span>
  </div>
  <div id="felled-row" class="row">
    <span id="felled-label" class="label">Fallna</span>
    <span id="last-round-felled" class="value">-</span>
  </div>
  <div id="best-row" class="row">
    <span id="best-label" class="label">Rekord</span>
    <span id="best-felled" class="value">0</span>
  </div>
  <div id="style-row" class="row">
    <span id="style-label" class="label">Stil</span>
    <span id="throw-style" class="value">-</span>
  </div>
  <div id="role-row" class="row" style="display: none">
    <span id="role-label" class="label">Du är</span>
    <span id="role-value" class="value">-</span>
  </div>
  <div id="match-row" class="row" style="display: none">
    <span id="match-label" class="label">Match</span>
    <div class="score">
      <span id="match-score-a" class="value">0</span>
      <span class="value">-</span>
      <span id="match-score-b" class="value">0</span>
    </div>
  </div>
  <div id="turn-row" class="row" style="display: none">
    <span id="turn-label" class="label">Tur</span>
    <span id="turn-value" class="value">-</span>
  </div>
  <!-- Kubbs left to toss in, on its own row: appended to the turn it
       wrapped onto two lines and pushed the panel off its board. -->
  <div id="inkast-row" class="row" style="display: none">
    <span id="inkast-label" class="label"></span>
    <span id="inkast-value" class="value">-</span>
  </div>
  <!-- Label deliberately empty: the value ("Kungen fälld") is the whole
       message, right-aligned under the verdict like the other values. -->
  <div id="end-reason-row" class="row" style="display: none">
    <span id="end-reason-label" class="label"></span>
    <span id="end-reason-value" class="value">-</span>
  </div>
  <!-- A server notice (a foot fault), shown for a couple of seconds. -->
  <div id="notice-row" class="row" style="display: none">
    <span id="notice-label" class="label"></span>
    <span id="notice-value" class="value">-</span>
  </div>
</Panel>
