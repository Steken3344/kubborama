<!--
  Always-visible scoreboard: current round number, last round's
  result, and the personal-best "most felled in one round". Driven by
  src/systems/hud.ts, which listens for RoundEnded — no per-frame
  polling needed, only updates when a round actually finishes.

  å/ä/ö now render correctly (gh#5, see public/ui/reset-menu.uikitml
  and docs/DECISIONS.md for the fix). Labels driven by
  src/i18nState.ts, refreshed by HudSystem on language change.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 220px;
    background-color: rgba(20, 20, 20, 0.55);
    border-radius: 12px;
    padding: 14px;
  }

  .row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 4px;
    padding-bottom: 4px;
  }

  .label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
  }

  .value {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
  }
</style>
<Panel class="panel-root">
  <div class="row">
    <span id="round-label" class="label">Runda</span>
    <span id="round-number" class="value">1</span>
  </div>
  <div class="row">
    <span id="felled-label" class="label">Fallna</span>
    <span id="last-round-felled" class="value">-</span>
  </div>
  <div class="row">
    <span id="best-label" class="label">Rekord</span>
    <span id="best-felled" class="value">0</span>
  </div>
</Panel>
