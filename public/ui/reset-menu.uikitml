<!--
  Panel, Divider, Button, and ButtonLabel come from the bundled Horizon
  kit. Toggled by the B button on the right controller — see
  src/systems/menu.ts. Hidden by default (display: none on the root).

  Button label avoids å/ä/ö on purpose: the bundled DM Sans .ttf (same
  hotlink the IWSDK starter template uses) doesn't render those glyphs
  here — confirmed live, not just in the isolated preview — even after
  swapping in a locally-hosted, Google-subset font built to include
  them. Root cause not chased further; docs/PLAN.md already scopes
  "åäö verified in font atlas" to M4, and this is now a concrete,
  investigated data point for that milestone (see docs/DECISIONS.md).
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 300px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 20px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .heading {
    height: 36px;
    text-align: center;
    font-size: 22px;
    font-weight: 700;
    color: #272727;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .button {
    justify-content: center;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 16px;
    margin-bottom: 24px;
  }
</style>
<Panel id="menu-root" class="panel-root" style="display: none">
  <div class="panel-content">
    <div class="heading">Meny</div>
    <Divider></Divider>
  </div>
  <Button id="reset-button" class="button">
    <ButtonLabel>Ny runda</ButtonLabel>
  </Button>
</Panel>
