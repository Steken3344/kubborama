<!--
  Panel, Divider, Button, and ButtonLabel come from the bundled Horizon
  kit. Toggled by the B button on the right controller — see
  src/systems/menu.ts. Hidden by default (display: none on the root).

  Text avoids å/ä/ö throughout on purpose (confirmed root cause, not a
  workaround guess — see docs/DECISIONS.md and gh#5): UIKitML's custom
  @font-face path always bakes its MSDF atlas from a hardcoded
  ASCII-only charset (@pmndrs/uikit's TTFLoader), regardless of what
  glyphs the source .ttf actually contains — there is currently no way
  to pass a wider charset through from UIKitML. Text driven by
  src/i18nState.ts (core/i18n.ts's translator over
  src/data/i18n/{sv,en}.json) — see src/systems/menu.ts.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 300px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 20px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .heading {
    height: 36px;
    text-align: center;
    font-size: 22px;
    font-weight: 700;
    color: #272727;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .button {
    justify-content: center;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 16px;
    margin-bottom: 24px;
  }
</style>
<Panel id="menu-root" class="panel-root" style="display: none">
  <div class="panel-content">
    <div id="menu-title" class="heading">Meny</div>
    <Divider></Divider>
  </div>
  <Button id="reset-button" class="button">
    <ButtonLabel id="reset-button-label">Ny runda</ButtonLabel>
  </Button>
  <Button id="language-button" class="button">
    <ButtonLabel id="language-button-label">Svenska</ButtonLabel>
  </Button>
  <Button id="game-mode-button" class="button">
    <ButtonLabel id="game-mode-button-label">Enkelt</ButtonLabel>
  </Button>
</Panel>
